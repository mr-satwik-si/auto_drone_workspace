<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="room">

    <!-- Physics -->
    <physics name="fast" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <background_color>0.5 0.5 0.5 1</background_color>
    </plugin>

    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Floor -->
    <model name="floor">
      <static>true</static>
      <pose>2 2 0 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box><size>8 6 0.1</size></box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box><size>8 6 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Wall North -->
    <model name="wall_north">
      <static>true</static>
      <pose>2 5 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 0.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8 0.2 2</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wall South -->
    <model name="wall_south">
      <static>true</static>
      <pose>2 -1 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 0.2 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8 0.2 2</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wall East -->
    <model name="wall_east">
      <static>true</static>
      <pose>6 2 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6 2</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wall West -->
    <model name="wall_west">
      <static>true</static>
      <pose>-2 2 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6 2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6 2</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Table -->
    <model name="table">
      <static>true</static>
      <pose>2.0 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 0.6 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 0.6 0.8</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Chair -->
    <model name="chair">
      <static>true</static>
      <pose>2.0 1.2 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.9</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.9</size></box></geometry>
          <material><ambient>0.2 0.2 0.6 1</ambient><diffuse>0.2 0.2 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bookshelf -->
    <model name="bookshelf">
      <static>true</static>
      <pose>3.5 3.8 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 1.2 1.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 1.2 1.8</size></box></geometry>
          <material><ambient>0.4 0.2 0.0 1</ambient><diffuse>0.4 0.2 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Sofa -->
    <model name="sofa">
      <static>true</static>
      <pose>0.8 3.5 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.8 0.7 0.8</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.8 0.7 0.8</size></box></geometry>
          <material><ambient>0.5 0.1 0.1 1</ambient><diffuse>0.5 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- TV Stand -->
    <model name="tv_stand">
      <static>true</static>
      <pose>2.0 0.2 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 0.4 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.2 0.4 0.5</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Plant pot -->
    <model name="plant">
      <static>true</static>
      <pose>3.8 0.3 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.1 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Box 1 -->
    <model name="box1">
      <static>true</static>
      <pose>1.5 1.5 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.8 0.8 0.0 1</ambient><diffuse>0.8 0.8 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Box 2 -->
    <model name="box2">
      <static>true</static>
      <pose>3.0 1.0 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.0 0.6 0.8 1</ambient><diffuse>0.0 0.6 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Fire object — bright red/orange to trigger fire detection -->
    <model name="fire_object">
      <static>true</static>
      <pose>2.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material>
            <ambient>1.0 0.2 0.0 1</ambient>
            <diffuse>1.0 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Charging Dock -->
    <model name="charging_dock">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.4 0.1</size></box></geometry>
          <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drone -->
    <model name="drone">
      <pose>0 0 1.2 0 0 0</pose>
      <static>true</static>
      <link name="base_link">
        <!-- Drone body -->
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="body_col">
          <geometry><box><size>0.4 0.4 0.1</size></box></geometry>
        </collision>
        <visual name="body_vis">
          <geometry><box><size>0.4 0.4 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material>
        </visual>

        <!-- Arm 1 -->
        <visual name="arm1">
          <pose>0.2 0 0 0 0 0.785</pose>
          <geometry><box><size>0.4 0.05 0.02</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>

        <!-- Arm 2 -->
        <visual name="arm2">
          <pose>0 0.2 0 0 0 -0.785</pose>
          <geometry><box><size>0.4 0.05 0.02</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>

        <!-- Camera sensor -->
        <sensor name="camera" type="camera">
          <pose>0.2 0 -0.05 0 0.3 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>30</far></clip>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
          <topic>/camera/image_raw</topic>
        </sensor>
        
        <!-- LiDAR sensor -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.1 0 0 0</pose>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.1</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>/scan</topic>
        </sensor>

      </link>

      <!-- Rotor visuals -->
      <link name="rotor_fl">
        <pose>0.2 0.2 0.12 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 0.7</ambient><diffuse>0.8 0.1 0.1 0.7</diffuse></material>
        </visual>
      </link>
      <link name="rotor_fr">
        <pose>0.2 -0.2 0.12 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.8 0.1 0.1 0.7</ambient><diffuse>0.8 0.1 0.1 0.7</diffuse></material>
        </visual>
      </link>
      <link name="rotor_bl">
        <pose>-0.2 0.2 0.12 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.1 0.7</ambient><diffuse>0.1 0.8 0.1 0.7</diffuse></material>
        </visual>
      </link>
      <link name="rotor_br">
        <pose>-0.2 -0.2 0.12 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.1 0.7</ambient><diffuse>0.1 0.8 0.1 0.7</diffuse></material>
        </visual>
      </link>

      <!-- Joint to keep drone together -->
      <joint name="rotor_fl_joint" type="fixed">
        <parent>base_link</parent><child>rotor_fl</child>
      </joint>
      <joint name="rotor_fr_joint" type="fixed">
        <parent>base_link</parent><child>rotor_fr</child>
      </joint>
      <joint name="rotor_bl_joint" type="fixed">
        <parent>base_link</parent><child>rotor_bl</child>
      </joint>
      <joint name="rotor_br_joint" type="fixed">
        <parent>base_link</parent><child>rotor_br</child>
      </joint>

      <!-- Move drone plugin -->
    <!-- Pose publisher only -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
      </plugin>

    </model>

    <!-- Drone 2 — starts at opposite corner -->
    <model name="drone2">
      <pose>4.0 4.0 0.05 0 0 0</pose>
      <static>true</static>
      <link name="base_link">
        <collision name="body_col">
          <geometry><box><size>0.4 0.4 0.1</size></box></geometry>
        </collision>
        <visual name="body_vis">
          <geometry><box><size>0.4 0.4 0.1</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
        <!-- Drone 2 Camera -->
        <sensor name="camera2" type="camera">
          <pose>0.2 0 -0.05 0 0.3 0</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>30</far></clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>true</visualize>
          <topic>/camera2/image_raw</topic>
        </sensor>
        <visual name="arm1">
          <pose>0.2 0 0 0 0 0.785</pose>
          <geometry><box><size>0.4 0.05 0.02</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
        <visual name="arm2">
          <pose>0 0.2 0 0 0 -0.785</pose>
          <geometry><box><size>0.4 0.05 0.02</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
      </link>
      <link name="rotor_fl">
        <pose>0.2 0.2 0.12 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.1 0.7</ambient></material>
        </visual>
      </link>
      <link name="rotor_fr">
        <pose>0.2 -0.2 0.12 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.1 0.7</ambient></material>
        </visual>
      </link>
      <link name="rotor_bl">
        <pose>-0.2 0.2 0.12 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.5 0.7</ambient></material>
        </visual>
      </link>
      <link name="rotor_br">
        <pose>-0.2 -0.2 0.12 0 0 0</pose>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.8 0.5 0.7</ambient></material>
        </visual>
      </link>
      <joint name="rotor_fl_joint" type="fixed">
        <parent>base_link</parent><child>rotor_fl</child>
      </joint>
      <joint name="rotor_fr_joint" type="fixed">
        <parent>base_link</parent><child>rotor_fr</child>
      </joint>
      <joint name="rotor_bl_joint" type="fixed">
        <parent>base_link</parent><child>rotor_bl</child>
      </joint>
      <joint name="rotor_br_joint" type="fixed">
        <parent>base_link</parent><child>rotor_br</child>
      </joint>
    </model>

    <!-- Drone 2 charging dock -->
    <model name="charging_dock2">
      <static>true</static>
      <pose>4.0 4.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.4 0.1</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
